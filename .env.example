# Copy to .env and adjust. Never commit .env.
#   cp .env.example .env && ./scripts/gen-secrets.sh .env     (replaces the placeholder secrets below)
#   docker compose up -d --build                               (full stack; see docs/DEPLOYMENT.md)

# --- Public entrypoint (Caddy reverse proxy) ---
# ":80" = plain HTTP on any host. A domain (citysense.example.com) = automatic HTTPS certificates.
SITE_ADDRESS=:80
# Static citizen portal served at "/" (sibling govt_website checkout by default)
PORTAL_DIR=../govt_portal

# --- Database (docker compose + Spring datasource) ---
POSTGRES_DB=citysense
POSTGRES_USER=citysense
POSTGRES_PASSWORD=citysense
DB_PORT=5432

# --- Auth ---
# HMAC secret for JWT signing; MUST be at least 32 bytes (256 bits).
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_EXPIRATION_MINUTES=720
# Shared key the AI service sends when calling internal core endpoints.
INTERNAL_API_KEY=change-me-internal-api-key

# --- Runtime behaviour ---
# 1 = demo mode (simulated data, faster escalation); 0 = off
DEMO_MODE=1
ESCALATION_TICK_SECONDS=10

# --- AI agent service (voice agent + planner; core proxies avatar chat to it) ---
# Sarvam: STT saaras:v3 + TTS bulbul:v3. Groq: primary LLM + Whisper STT fallback.
SARVAM_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional hosted vision model for CCTV triage in emergency_routing
OLLAMA_API_KEY=
PROVIDER_ORDER=groq,sarvam
STT_PROVIDER_ORDER=sarvam,groq
# 1 enables /agent/api/auth/dev-token for the demo dashboard (/agent/ui). Never 1 on a public host.
AGENT_DEMO_MODE=0
# Agent tools may call Nominatim (geocoding) and Open-Meteo (air quality); 0 = offline gazetteer/samples
PUBLIC_DATA_APIS=1
AGENT_TIMEOUT_SECONDS=30
CORS_ALLOWED_ORIGINS=*
AGENT_CORS_ORIGINS=["*"]

# --- Correlation engine ---
CORRELATION_RADIUS_METERS=500
CORRELATION_WINDOW_MINUTES=30

# --- Email OTP (account verification + password reset) ---
# Leave SPRING_MAIL_HOST empty in local dev: codes are printed to the core log instead.
# Gmail example: host smtp.gmail.com, port 587, username = address, password = an App Password.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
OTP_MAIL_FROM=no-reply@citysense.local
# Set false anywhere real: never log codes outside local development.
OTP_LOG_FALLBACK=true

# --- Maps (all calls proxied by core; the mobile app never calls these directly) ---
# Public OpenStreetMap servers: identify yourself, show attribution, no heavy use.
GEO_USER_AGENT=CitySense/0.1 (+https://github.com/Adityakeerti/CitySense)
GEO_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GEO_NOMINATIM_URL=https://nominatim.openstreetmap.org
GEO_OSRM_URL=https://router.project-osrm.org
# Set when core sits behind a proxy so tile URLs in the map style are reachable by phones.
GEO_PUBLIC_BASE_URL=
GEO_DEFAULT_LAT=30.3243
GEO_DEFAULT_LNG=78.0418
GEO_GEOFENCE_RADIUS_METERS=2500

# --- Avatars / demo users ---
SEED_AVATARS=true
SEED_USERS=true

# Govt-portal operator key: officers enter it in the portal to publish/revoke notices
# (sent as X-Operator-Key). Unset = notice publishing disabled. ./scripts/gen-secrets.sh generates one.
OPERATOR_KEY=
