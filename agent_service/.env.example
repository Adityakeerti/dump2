# Run python -m scripts.bootstrap to create .env with a random JWT secret.
APP_NAME=city-sense-ai
ENVIRONMENT=development
DEMO_MODE=0
POSTGRES_USER=citysense
POSTGRES_DB=citysense
POSTGRES_PASSWORD=GENERATE_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://citysense:GENERATE_DATABASE_PASSWORD@localhost:5432/citysense
JWT_SECRET=GENERATE_WITH_BOOTSTRAP
JWT_ALGORITHM=HS256
JWT_ISSUER=
JWT_AUDIENCE=
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_DIMENSION=384
USE_SENTENCE_TRANSFORMER=1
EMBEDDING_LOCAL_FILES_ONLY=0
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=local-model
# LOCAL_LLM_API_KEY=
LOCAL_TOOLS_ENABLED=0
GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_STT_MODEL=whisper-large-v3-turbo
SARVAM_BASE_URL=https://api.sarvam.ai
# SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v3
PROVIDER_ORDER=local,groq,sarvam
STT_PROVIDER_ORDER=local,groq,sarvam
# LOCAL_STT_BASE_URL=http://localhost:8081/v1
LOCAL_STT_MODEL=whisper-1
PROVIDER_TIMEOUT_SECONDS=20
REQUEST_TIMEOUT_SECONDS=90
PROVIDER_RPM=20
PROVIDER_COOLDOWN_SECONDS=60
LLM_MAX_CONCURRENCY=4
MAX_PROVIDER_ANSWER_CHARS=16000
MAX_MESSAGE_LENGTH=4000
MAX_UPLOAD_BYTES=10485760
ACTION_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=10
DEFAULT_CITY_ID=dehradun
SOURCE_FRESHNESS_DAYS=90
CACHE_TTL_SECONDS=3600
UPLOAD_DIR=data/uploads
INGESTION_TIMEOUT_SECONDS=120
# COMPLAINT_ADAPTER_URL=https://your-platform/api/complaints
# COMPLAINT_STATUS_URL=https://your-platform/api/complaints/status
# EVENTS_URL=https://your-platform/api/events
# ALERTS_URL=https://your-platform/api/alerts
# ADAPTER_API_KEY=
CORS_ORIGINS=[]
REFRESH_ALLOWED_DOMAINS=[]
REFRESH_INTERVAL_SECONDS=3600
LOG_LEVEL=INFO
