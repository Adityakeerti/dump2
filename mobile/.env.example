# Base URL of CitySense core (Spring Boot): auth, map, avatars, agent, incidents.
#   Android emulator -> host machine: http://10.0.2.2:8080
#   Physical phone on the same Wi-Fi: http://<your-computer-LAN-IP>:8080
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080
# Optional request timeout for API calls (ms)
EXPO_PUBLIC_API_TIMEOUT_MS=15000
# Complaint module (complaints + govt-portal notices). Direct port in dev; leave unset behind Caddy,
# where it defaults to <API_BASE_URL>/api/complaint-flow.
#   Android emulator: http://10.0.2.2:8001   Phone on Wi-Fi: http://<your-computer-LAN-IP>:8001
EXPO_PUBLIC_COMPLAINT_SERVICE_URL=http://10.0.2.2:8001
# Government notices feed: the govt portal's published JSON (same list as its /notices page).
# Unset = the complaint module's /api/notices.
EXPO_PUBLIC_NOTICES_URL=https://govtwebsite.vercel.app/api/notices
